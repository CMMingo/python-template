# Dependabot config: opt-in. Delete this line to commit .github/dependabot.yaml
.github/dependabot.yaml

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv (uv.lock is committed)
.uv/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.pyright/

# Ruff
.ruff_cache/

{% if use_ml %}
# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints
{% endif %}

# Logs
logs/*
!logs/.gitkeep

{% if use_ml %}
# Data (keep structure, ignore contents)
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep

# ML runs
runs/mlruns/*
!runs/mlruns/.gitkeep
runs/artifacts/*
!runs/artifacts/.gitkeep

# Results
results/*
!results/.gitkeep
{% endif %}

# Generated docs
docs/build/

# Configs with secrets (keep the base, ignore local overrides)
config/config.local.yaml

# Environment variables
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
{%- if project_layout == 'product' %}

# Frontend
node_modules/
frontend/dist/
frontend/.env.local
{%- endif %}
