{%- set product = project_layout == 'product' -%}
# Python lives in {{ 'backend/' if product else 'the repo root' }}; every Python recipe runs from there, so `make <target>` works from anywhere in the repo.
PY_DIR := {{ 'backend' if product else '.' }}
PACKAGE := {{ package_name }}

.DEFAULT_GOAL := help

.PHONY: help setup install sync{{ ' dev' if product }} test test-py{{ ' test-frontend' if product }} test-fast lint lint-py{{ ' lint-frontend' if product }} typecheck \
        format format-check fix pre-commit docs docs-serve{{ ' dvc-pull dvc-push dvc-repro' if use_ml }} clean

help:  ## Show this help message
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

# ── Environment ────────────────────────────────────────────────────────────────

setup:  ## Bootstrap a fresh clone (check tools, install deps and the pre-commit hook{{ ', DVC' if use_ml }}, .env)
	bash scripts/setup.sh

sync:  ## Install the Python dependencies from the lockfile
	cd $(PY_DIR) && uv sync

install: sync  ## Install dependencies and the pre-commit git hook
	cd $(PY_DIR) && uv run pre-commit install
{%- if product %}
	@if [ -f frontend/package.json ]; then cd frontend && npm install; fi
{%- endif %}

{% if product -%}
# ── Development ────────────────────────────────────────────────────────────────

dev:  ## Start the backend and frontend dev servers (fill in scripts/dev.sh first)
	bash scripts/dev.sh

{% endif -%}
# ── Code quality ───────────────────────────────────────────────────────────────

{% if product -%}
test: test-py test-frontend  ## Run all tests
{%- else -%}
test: test-py  ## Run tests
{%- endif %}

test-py:  ## Run Python tests with coverage
	cd $(PY_DIR) && uv run pytest
{% if product %}
test-frontend:  ## Run frontend tests (skipped until frontend/package.json exists)
	@if [ -f frontend/package.json ]; then cd frontend && npm run test; else echo "no frontend yet: see frontend/decide-frontend-style.md"; fi
{% endif %}
test-fast:  ## Run Python tests without coverage
	cd $(PY_DIR) && uv run pytest --no-cov

{% if product -%}
lint: lint-py typecheck lint-frontend  ## Run every linter and the type check
{%- else -%}
lint: lint-py typecheck  ## Run Ruff and the type check
{%- endif %}

lint-py:  ## Lint Python with Ruff
	cd $(PY_DIR) && uv run ruff check .
{% if product %}
lint-frontend:  ## Lint the frontend (skipped until frontend/package.json exists)
	@if [ -f frontend/package.json ]; then cd frontend && npm run lint; else echo "no frontend yet: see frontend/decide-frontend-style.md"; fi
{% endif %}
typecheck:  ## Type-check with ty
	cd $(PY_DIR) && uv run ty check

format:  ## Format with Ruff
	cd $(PY_DIR) && uv run ruff format .

format-check:  ## Check formatting without changing files (used by CI)
	cd $(PY_DIR) && uv run ruff format --check .

fix:  ## Lint and auto-fix with Ruff
	cd $(PY_DIR) && uv run ruff check --fix .
	cd $(PY_DIR) && uv run ruff format .

pre-commit:  ## Run pre-commit hooks on all files
	cd $(PY_DIR) && uv run pre-commit run --all-files

# ── Docs ───────────────────────────────────────────────────────────────────────

docs:  ## Generate HTML docs with pdoc into docs/build
	cd $(PY_DIR) && uv run --with pdoc pdoc --output-dir $(CURDIR)/docs/build $(PACKAGE)
	@echo "Docs generated at docs/build/index.html"

docs-serve:  ## Serve docs locally with live reload
	cd $(PY_DIR) && uv run --with pdoc pdoc $(PACKAGE)
{% if use_ml %}
# ── DVC ────────────────────────────────────────────────────────────────────────

dvc-pull:  ## Pull data and artifacts from remote
	uv run --project $(PY_DIR) dvc pull

dvc-push:  ## Push data and artifacts to remote
	uv run --project $(PY_DIR) dvc push

dvc-repro:  ## Reproduce the full DVC pipeline
	uv run --project $(PY_DIR) dvc repro
{% endif %}
# ── Cleanup ────────────────────────────────────────────────────────────────────

clean:  ## Remove build artifacts and caches
	find . \( -name node_modules -o -name .venv -o -name .git \) -prune -o -type d \( -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache -o -name "*.egg-info" -o -name dist -o -name build \) -exec rm -rf {} +
	find . \( -name node_modules -o -name .venv -o -name .git \) -prune -o \( -name "*.pyc" -o -name ".coverage" \) -type f -delete
