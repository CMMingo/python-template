# DVC Pipeline
# Docs: https://dvc.org/doc/user-guide/project-structure/dvcyaml-files
#
# Run the full pipeline:   dvc repro
# Run a single stage:      dvc repro <stage_name>
# Check status:            dvc status
# Push data/artifacts:     dvc push

stages:

  prepare:
    cmd: uv run {{ '--project backend ' if project_layout == 'product' else '' }}python -m {{ package_name }}.pipeline.prepare
    deps:
      - data/raw
      - {{ py_root }}{{ package_name }}/pipeline/prepare.py
    outs:
      - data/processed

  train:
    cmd: uv run {{ '--project backend ' if project_layout == 'product' else '' }}python -m {{ package_name }}.pipeline.train
    deps:
      - data/processed
      - {{ py_root }}{{ package_name }}/pipeline/train.py
      - config/config.yaml
    outs:
      - runs/artifacts/model
    metrics:
      - runs/artifacts/metrics.json:
          cache: false

  evaluate:
    cmd: uv run {{ '--project backend ' if project_layout == 'product' else '' }}python -m {{ package_name }}.pipeline.evaluate
    deps:
      - data/processed
      - runs/artifacts/model
      - {{ py_root }}{{ package_name }}/pipeline/evaluate.py
    metrics:
      - runs/artifacts/evaluation.json:
          cache: false
    plots:
      - runs/artifacts/plots.csv:
          cache: false
