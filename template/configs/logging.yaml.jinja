version: 1
disable_existing_loggers: false

formatters:
  standard:
    format: "%(asctime)s | %(levelname)-8s | %(name)s:%(lineno)d - %(message)s"
    datefmt: "%Y-%m-%d %H:%M:%S"

handlers:
  console:
    class: logging.StreamHandler
    formatter: standard
    stream: ext://sys.stdout

  file:
    class: logging.handlers.RotatingFileHandler
    formatter: standard
    filename: logs/{{ project_name }}.log
    maxBytes: 10485760  # 10 MB
    backupCount: 5
    encoding: utf-8

root:
  level: INFO
  handlers: [console, file]

loggers:
  {{ project_name }}:
    level: INFO
    handlers: [console, file]
    propagate: false

  # Third-party loggers — suppress noise
  httpx:
    level: WARNING
  httpcore:
    level: WARNING
