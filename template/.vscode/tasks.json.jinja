{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test",
      "type": "shell",
      "command": "make test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": []
    },
    {
      "label": "Type-check",
      "type": "shell",
      "command": "make typecheck",
      "problemMatcher": []
    },
    {
      "label": "Fix (lint and format)",
      "type": "shell",
      "command": "make fix",
      "problemMatcher": []
    }{% if project_layout == 'product' %},
    {
      "label": "Dev: start backend and frontend",
      "type": "shell",
      "command": "make dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }{% endif %}
  ]
}
