services:

  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: {{ project_name }}:latest
    container_name: {{ project_name }}_app
    env_file:
      - .env
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs
      - ./runs:/app/runs
      - ./results:/app/results
      - ./configs:/app/configs
    # ports:
    #   - "8000:8000"
    restart: unless-stopped

